# Copy to .env (never commit real values). All optional in development.
NODE_ENV=production
PORT=3000
# Public URL; required in production (used in emails/invite links and to validate the Origin header).
BASE_URL=https://remarca.example.com
# SQLite file on a persistent disk.
DATABASE_PATH=/var/lib/remarca/remarca.sqlite
# Set to 1 when running behind a reverse proxy (Caddy/Nginx) so rate limits see the client IP.
TRUST_PROXY=1
# Password-reset emails via https://resend.com (without it, emails are not delivered; use `npm run admin -- reset-link`).
RESEND_API_KEY=
MAIL_FROM=Remarcá <hola@remarca.example.com>
# Contact shown on the plan page (WhatsApp digits with country code, e.g. 5491122334455).
CONTACT_WHATSAPP=
CONTACT_EMAIL=hola@remarca.example.com
# Legal name / CUIT shown in the terms page.
LEGAL_ENTITY=
# Abuse limits.
SIGNUP_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15M=10
